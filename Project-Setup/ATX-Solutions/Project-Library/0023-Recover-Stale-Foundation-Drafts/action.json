    },
    {
      "name": "staleFoundationDraftsDeleted",
      "type": "Integer",
      "required": true
    },
    {
      "name": "staleFoundationDraftIds",
      "type": "String",
      "required": true
    },
    {
      "name": "staleFoundationCleanupOutcome",
      "type": "String",
      "required": true
    }
  ],
  "evidencePolicy": {
    "onPass": "StructuredOnly",
    "onFailure": "ScreenshotAndDiagnostics"
  }
}
