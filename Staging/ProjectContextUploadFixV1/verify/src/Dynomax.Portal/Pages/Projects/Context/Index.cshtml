@page
@model Dynomax.Portal.Pages.Projects.Context.IndexModel
@{
    ViewData["Title"] = "Project Context";
    var selected = Model.SelectedResource?.Resource;
    var selectedVersions = Model.SelectedResource?.Versions ?? [];
}

<style>
.pc-page{display:flex;flex-direction:column;gap:18px;min-width:0}.pc-heading{display:flex;justify-content:space-between;gap:20px;align-items:flex-start}.pc-heading h1{margin:0 0 6px;font-size:28px;line-height:1.15}.pc-heading p{margin:0;color:var(--muted,#667085);max-width:720px}.pc-metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px}.pc-card{background:#fff;border:1px solid #e6eaf0;border-radius:12px;box-shadow:0 1px 2px rgba(16,24,40,.03)}.pc-metric{padding:14px 16px;display:flex;align-items:center;gap:12px;min-height:72px}.pc-metric-icon{width:34px;height:34px;border-radius:9px;display:grid;place-items:center;background:#f3f5ff;color:#5b4df5;font-size:18px}.pc-metric-label{font-size:12px;color:#667085}.pc-metric-value{font-size:20px;font-weight:700;color:#101828}.pc-toolbar{display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap}.pc-toolbar-group{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.pc-btn{height:36px;padding:0 13px;border:1px solid #d9dee8;background:#fff;border-radius:8px;color:#344054;font:inherit;display:inline-flex;align-items:center;gap:7px;text-decoration:none;cursor:pointer}.pc-btn:hover{background:#f8f9fb}.pc-btn.primary{background:#5b4df5;color:#fff;border-color:#5b4df5}.pc-btn.danger{border-color:#f3b4b4;color:#d92d20;background:#fff}.pc-search{height:36px;min-width:260px;border:1px solid #d9dee8;border-radius:8px;padding:0 12px}.pc-select{height:36px;border:1px solid #d9dee8;border-radius:8px;padding:0 30px 0 10px;background:#fff}.pc-workspace{display:grid;grid-template-columns:205px minmax(0,1fr);gap:14px;align-items:start}.pc-sidebar{padding:10px}.pc-sidebar-head{display:flex;align-items:center;justify-content:space-between;padding:6px 8px 10px;font-weight:700}.pc-collection{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:9px 9px;border-radius:8px;color:#344054;text-decoration:none;font-size:13px}.pc-collection:hover{background:#f8f9fb}.