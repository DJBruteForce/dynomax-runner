@model Dynomax.Portal.Pages.Projects.Context.IndexModel
@{ var row=Model.SelectedRepository!; var repo=row.Connection; var credential=row.Credential; }
<aside class="pc-card pc-drawer" role="dialog" aria-modal="false" aria-label="Repository properties">
<div class="pc-drawer-title"><span>@repo.FullName</span><a class="pc-drawer-close" aria-label="Close repository properties" asp-route-projectId="@Model.Project.Id" asp-route-category="@IndexModel.RepositoryCollectionName" asp-route-q="@Model.SearchQuery" asp-route-filter="@Model.Filter" asp-route-sort="@Model.RepositorySort" asp-route-page="@Model.PageNumber" asp-route-pageSize="@Model.PageSize">&times;</a></div>
<div class="pc-tabs"><button class="pc-tab active" data-pc-tab="repo-details">Details</button><button class="pc-tab" data-pc-tab="repo-policy">Policy</button><button class="pc-tab" data-pc-tab="repo-topology">Topology</button></div>
<div class="pc-tab-panel active" data-pc-panel="repo-details"><div class="pc-info"><strong>Repository information</strong><dl class="pc-info-row"><dt>Provider</dt><dd>@repo.Provider</dd></dl><dl class="pc-info-row"><dt>Identity</dt><dd>@repo.FullName</dd></dl><dl class="pc-info-row"><dt>Provider ID</dt><dd><code>@repo.ProviderRepositoryId</code></dd></dl><dl class="pc-info-row"><dt>Visibility</dt><dd>@repo.Visibility</dd></dl><dl class="pc-info-row"><dt>Role</dt><dd>@(repo.Role ?? "-")</dd></dl><dl class="pc-info-row"><dt>Purpose</dt><dd>@(repo.Purpose ?? "-")</dd></dl><dl class="pc-info-row"><dt>Health</dt><dd><span class="pc-repo-health @HealthClass(repo.HealthStatus)">@repo.HealthStatus</span></dd></dl><dl class="pc-info-row"><dt>Last refresh</dt><dd>@Relative(repo.LastRefreshedAtUtc)</dd></dl><dl class="pc-info-row"><dt>Default branch</dt><dd>@(repo.DefaultBranch ?? "No branch")</dd></dl><dl class="pc-info-row"><dt>Current HEAD</dt><dd><code>@(repo.DefaultBranchHeadSha is null ? "No commits yet" : repo.DefaultBranchHeadSha)</code></dd></dl><dl class="pc-info-row"><dt>Current tree</dt><dd><code>@(repo.DefaultTreeSha is null ? "No tree yet" : repo.DefaultTreeSha)</code></dd></dl></div><div class="pc-info pc-repo-credential"><strong>Protected credential</strong><dl class="pc-info-row"><dt>Alias</dt><dd>@(credential?.DisplayName ?? "Unavailable")</dd></dl><dl class="pc-info-row"><dt>Key</dt><dd>@(credential?.Key ?? "-")</dd></dl><dl class="pc-info-row"><dt>Provider type</dt><dd>@(credential?.Provider ?? "Unavailable")</dd></dl><dl class="pc-info-row"><dt>Environment</dt><dd>@(credential?.EnvironmentKey ?? "-")</dd></dl><div class="pc-note">Secret values and provider references are intentionally never rendered.</div></div><div class="pc-actions">@if(Model.CanManage){<form method="post" asp-page-handler="RefreshRepository" asp-route-projectId="@Model.Project.Id" asp-route-repositoryContextId="@repo.RepositoryContextId"><button class="pc-btn" type="submit"> Refresh</button></form>}<a class="pc-btn" href="@repo.WebUrl" target="_blank" rel="noopener noreferrer"> Open on GitHub</a>@if(Model.CanManage){<button class="pc-btn wide" type="button" onclick="document.getElementById('pc-manage-repository-dialog')?.showModal()"> Change credential &amp; policy</button><form class="wide" method="post" asp-page-handler="DisconnectRepository" asp-route-projectId="@Model.Project.Id" asp-route-repositoryContextId="@repo.RepositoryContextId"><input type="hidden" name="expectedConcurrencyToken" value="@repo.ConcurrencyToken"/><button class="pc-btn danger" style="width:100%;justify-content:center" type="submit">Disconnect repository</button></form>}</div></div>
<div class="pc-tab-panel" data-pc-panel="repo-policy"><div class="pc-info"><strong>Effective repository policy</strong><dl class="pc-info-row"><dt>Read</dt><dd>@YesNo(repo.Policy.AllowRead)</dd></dl><dl class="pc-info-row"><dt>Workspace</dt><dd>@YesNo(repo.Policy.AllowWorkspace)</dd></dl><dl class="pc-info-row"><dt>Commit &amp; push</dt><dd>@YesNo(repo.Policy.AllowCommitPush)</dd></dl><dl class="pc-info-row"><dt>Pull requests</dt><dd>@YesNo(repo.Policy.AllowPullRequest)</dd></dl><dl class="pc-info-row"><dt>Merge</dt><dd>@YesNo(repo.Policy.AllowMerge)</dd></dl><dl class="pc-info-row"><dt>Direct default write</dt><dd>@YesNo(repo.Policy.AllowDirectDefaultBranchWrite)</dd></dl><dl class="pc-info-row"><dt>Force push</dt><dd>@YesNo(repo.Policy.AllowForcePush)</dd></dl><dl class="pc-info-row"><dt>PR required</dt><dd>@YesNo(repo.Policy.RequirePullRequestForDefaultBranch)</dd></dl><dl class="pc-info-row"><dt>Agent prefix</dt><dd><code>@repo.Policy.AgentBranchPrefix</code></dd></dl><dl class="pc-info-row"><dt>Target branches</dt><dd>@Patterns(repo.Policy.AllowedTargetBranchPatterns)</dd></dl><dl class="pc-info-row"><dt>Base branches</dt><dd>@Patterns(repo.Policy.AllowedBaseBranchPatterns)</dd></dl></div></div>
<div class="pc-tab-panel" data-pc-panel="repo-topology"><div class="pc-info"><strong>Repository topology summary</strong><dl class="pc-info-row"><dt>Current ref</dt><dd>@(repo.DefaultBranch ?? "No branch")</dd></dl><dl class="pc-info-row"><dt>HEAD</dt><dd><code>@(repo.DefaultBranchHeadSha is null ? "No commits yet" : ShortSha(repo.DefaultBranchHeadSha))</code></dd></dl><dl class="pc-info-row"><dt>Tree</dt><dd><code>@(repo.DefaultTreeSha is null ? "No tree yet (empty repository)" : ShortSha(repo.DefaultTreeSha))</code></dd></dl><dl class="pc-info-row"><dt>Open workspaces</dt><dd>@row.OpenWorkspaceCount</dd></dl><dl class="pc-info-row"><dt>Open PRs</dt><dd>@row.OpenPullRequestCount</dd></dl><div class="pc-note">Full tree browsing and cross-repository source search are delivered in P031-S013. S012 shows only trusted connection/ref topology already available from GitHub.</div></div></div>
</aside>
@if(Model.CanManage){<dialog class="pc-modal" id="pc-manage-repository-dialog"><div class="pc-modal-head"><strong>Manage @repo.FullName</strong><button class="pc-btn" type="button" onclick="this.closest('dialog').close()">&times;</button></div><form method="post" asp-page-handler="UpdateRepository" asp-route-projectId="@Model.Project.Id" class="pc-modal-body"><input asp-for="RepositoryEditInput.RepositoryContextId" type="hidden"/><input asp-for="RepositoryEditInput.ExpectedConcurrencyToken" type="hidden"/><div class="pc-form-grid"><label class="pc-field wide"><span>Protected credential</span><select asp-for="RepositoryEditInput.CredentialSecretReferenceId">@foreach(var option in Model.RepositoryCredentialOptions){<option value="@option.SecretReferenceId">@option.DisplayName / @option.EnvironmentKey / @option.Provider</option>}</select></label><label class="pc-field"><span>Role</span><input asp-for="RepositoryEditInput.Role"/></label><label class="pc-field"><span>Tags</span><input asp-for="RepositoryEditInput.Tags"/></label><label class="pc-field wide"><span>Purpose</span><textarea asp-for="RepositoryEditInput.Purpose" rows="2"></textarea></label><div class="pc-checks"><label class="pc-check"><input asp-for="RepositoryEditInput.AllowRead"/> Allow repository reads</label><label class="pc-check"><input asp-for="RepositoryEditInput.AllowWorkspace"/> Allow agent workspaces</label><label class="pc-check"><input asp-for="RepositoryEditInput.AllowCommitPush"/> Allow commit/push path</label><label class="pc-check"><input asp-for="RepositoryEditInput.AllowPullRequest"/> Allow pull-request path</label><label class="pc-check"><input asp-for="RepositoryEditInput.RequirePullRequestForDefaultBranch"/> Require PR for default branch</label></div><label class="pc-field"><span>Agent branch prefix</span><input asp-for="RepositoryEditInput.AgentBranchPrefix"/></label><label class="pc-field"><span>Allowed target branches</span><input asp-for="RepositoryEditInput.AllowedTargetBranchPatterns" placeholder="comma separated"/></label><label class="pc-field wide"><span>Allowed base branches</span><input asp-for="RepositoryEditInput.AllowedBaseBranchPatterns" placeholder="comma separated"/></label><div class="pc-note wide">High-risk permissions such as merge, force push, direct default-branch writes, remote branch deletion and Actions reruns remain unavailable in this phase.</div></div><div class="pc-modal-foot"><button class="pc-btn" type="button" onclick="this.closest('dialog').close()">Cancel</button><button class="pc-btn primary" type="submit">Save repository settings</button></div></form></dialog>}
@functions { static string YesNo(bool value)=>value?"Allowed":"Denied"; static string ShortSha(string value)=>value[..Math.Min(12,value.Length)]; static string Patterns(IReadOnlyList<string> values)=>values.Count==0?"Any policy-safe branch":string.Join(", ",values); static string Relative(DateTime? utc){if(utc is null)return "Never";var age=DateTime.UtcNow-utc.Value;if(age.TotalMinutes<1)return "just now";if(age.TotalHours<1)return $"{Math.Max(1,(int)age.TotalMinutes)} min ago";if(age.TotalDays<1)return $"{Math.Max(1,(int)age.TotalHours)} hours ago";return utc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm");} static string HealthClass(string value)=>value.ToLowerInvariant() switch{"healthy"=>"healthy","empty"=>"empty","error"=>"error","disconnected"=>"disconnected",_=>"unknown"}; }