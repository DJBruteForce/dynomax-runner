{
  "schemaVersion": 1,
  "actionId": "demo.website.capture",
  "displayName": "Capture homepage screenshot",
  "projectKey": "dynomax-demo",
  "engine": "RobotBrowser",
  "entryPoint": "action.resource",
  "keyword": "Demo Capture Homepage Screenshot",
  "sessionBehavior": "RequiresNewOrExistingBrowser",
  "timeoutSeconds": 60,
  "outputs": [
    {
      "name": "screenshotFile",
      "type": "String",
      "required": true
    }
  ],
  "evidencePolicy": {
    "onPass": "StructuredOnly",
    "onFailure": "ScreenshotAndDiagnostics"
  }
}
